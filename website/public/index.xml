    <item>
      <title>MNIST Digit Recognizer</title>
      <link>http://localhost:1313/posts/mnist/</link>
      <pubDate>Mon, 18 May 2026 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/posts/mnist/</guid>
      <description>&lt;p&gt;MNIST digit recognizer from scratch just using Numpy.&lt;/p&gt;&#xA;&lt;!DOCTYPE html&gt;&#xA;&lt;html&gt;&#xA;&#xA;&lt;head&gt;&#xA;        &lt;meta charset=&#34;UTF-8&#34;&gt;&#xA;        &lt;title&gt;MNIST Predictor&lt;/title&gt;&#xA;        &lt;style&gt;&#xA;                 &#xA;&#xA;                canvas {&#xA;                        text-align: center;&#xA;                        cursor: crosshair;&#xA;                        background: black;&#xA;                        border: 2px solid white;&#xA;                        touch-action: auto;&#xA;                        display: block;&#xA;                        margin: 0 auto;&#xA;                }&#xA;&#xA;                button {&#xA;                        margin: 10px;&#xA;                        padding: 10px 20px;&#xA;                        font-size: 18px;&#xA;                        cursor: pointer;&#xA;                }&#xA;&#xA;                #prediction {&#xA;                        text-align: center;&#xA;                        font-size: 40px;&#xA;                        margin-top: 20px;&#xA;                }&#xA;        &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&#xA;&lt;body&gt;&#xA;&#xA;        &lt;h1 style=&#34;text-align: center;&#34;&gt;Draw a Digit&lt;/h1&gt;&#xA;&#xA;        &lt;canvas id=&#34;canvas&#34; width=&#34;280&#34; height=&#34;280&#34;&gt;&lt;/canvas&gt;&#xA;&#xA;        &lt;div style=&#34;text-align: center;&#34;&gt;&#xA;        &lt;button onclick=&#34;predict()&#34;&gt;Predict&lt;/button&gt;&#xA;        &lt;button onclick=&#34;clearCanvas()&#34;&gt;Clear&lt;/button&gt;&#xA;        &lt;/div&gt;&#xA;&#xA;        &lt;div id=&#34;prediction&#34;&gt;Prediction: ?&lt;/div&gt;&#xA;&#xA;        &lt;script&gt;&#xA;                const canvas = document.getElementById(&#34;canvas&#34;);&#xA;                const ctx = canvas.getContext(&#34;2d&#34;);&#xA;&#xA;                ctx.fillStyle = &#34;black&#34;;&#xA;                ctx.fillRect(0, 0, canvas.width, canvas.height);&#xA;&#xA;                &#xA;                ctx.strokeStyle = &#34;white&#34;;&#xA;                ctx.lineWidth = 24;&#xA;                ctx.lineCap = &#34;round&#34;;&#xA;                ctx.lineJoin = &#34;round&#34;;&#xA;&#xA;                let drawing = false;&#xA;&#xA;                canvas.addEventListener(&#34;mousedown&#34;, (e) =&gt; {&#xA;                        drawing = true;&#xA;                        ctx.beginPath();&#xA;                        const rect = canvas.getBoundingClientRect();&#xA;                        ctx.moveTo(e.clientX - rect.left, e.clientY - rect.top);&#xA;                });&#xA;&#xA;                canvas.addEventListener(&#34;mouseup&#34;, () =&gt; drawing = false);&#xA;                canvas.addEventListener(&#34;mouseleave&#34;, () =&gt; drawing = false);&#xA;                canvas.addEventListener(&#34;mousemove&#34;, draw);&#xA;&#xA;                function draw(e) {&#xA;                        if (!drawing) return;&#xA;&#xA;                        const rect = canvas.getBoundingClientRect();&#xA;                        const x = e.clientX - rect.left;&#xA;                        const y = e.clientY - rect.top;&#xA;&#xA;                        ctx.lineTo(x, y);&#xA;                        ctx.stroke();&#xA;                }&#xA;&#xA;                function clearCanvas() {&#xA;                        ctx.fillStyle = &#34;black&#34;;&#xA;                        ctx.fillRect(0, 0, canvas.width, canvas.height);&#xA;                        document.getElementById(&#34;prediction&#34;).innerText = &#34;Prediction: ?&#34;;&#xA;                }&#xA;&#xA;                let model = null;&#xA;&#xA;                async function loadModel() {&#xA;                        try {&#xA;                                const response = await fetch(&#34;/model.json&#34;);&#xA;                                if (!response.ok) {&#xA;                                        throw new Error(&#34;Failed to load model&#34;);&#xA;                                }&#xA;                                model = await response.json();&#xA;                                console.log(&#34;Model loaded successfully.&#34;);&#xA;                        } catch (err) {&#xA;                                console.error(err);&#xA;                                document.getElementById(&#34;prediction&#34;).innerText = &#34;Error loading model&#34;;&#xA;                        }&#xA;                }&#xA;&#xA;                loadModel();&#xA;&#xA;                function relu(arr) {&#xA;                        return arr.map(v =&gt; Math.max(0, v));&#xA;                }&#xA;&#xA;                function softmax(arr) {&#xA;                        const max = Math.max(...arr);&#xA;                        const exps = arr.map(v =&gt; Math.exp(v - max));&#xA;                        const sum = exps.reduce((a, b) =&gt; a + b, 0);&#xA;                        return exps.map(v =&gt; v / sum);&#xA;                }&#xA;&#xA;                function linear(x, w, b) {&#xA;                        const out = [];&#xA;                        for (let j = 0; j &lt; w[0].length; j++) {&#xA;                                let sum = b[0][j];&#xA;                                for (let i = 0; i &lt; x.length; i++) {&#xA;                                        sum += x[i] * w[i][j];&#xA;                                }&#xA;                                out.push(sum);&#xA;                        }&#xA;                        return out;&#xA;                }&#xA;&#xA;                &#xA;                function getInputTensor() {&#xA;                        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);&#xA;                        &#xA;                        &#xA;                        let minX = canvas.width;&#xA;                        let maxX = 0;&#xA;                        let minY = canvas.height;&#xA;                        let maxY = 0;&#xA;                        let hasPixels = false;&#xA;&#xA;                        &#xA;                        for (let y = 0; y &lt; canvas.height; y++) {&#xA;                                for (let x = 0; x &lt; canvas.width; x++) {&#xA;                                        const index = (y * canvas.width + x) * 4;&#xA;                                        const r = imgData.data[index]; &#xA;&#xA;                                        if (r &gt; 20) { &#xA;                                                if (x &lt; minX) minX = x;&#xA;                                                if (x &gt; maxX) maxX = x;&#xA;                                                if (y &lt; minY) minY = y;&#xA;                                                if (y &gt; maxY) maxY = y;&#xA;                                                hasPixels = true;&#xA;                                        }&#xA;                                }&#xA;                        }&#xA;&#xA;                        &#xA;                        if (!hasPixels) {&#xA;                                return new Array(784).fill(0);&#xA;                        }&#xA;&#xA;                        &#xA;                        const digitWidth = (maxX - minX) + 1;&#xA;                        const digitHeight = (maxY - minY) + 1;&#xA;&#xA;                        &#xA;                        const tempCanvas = document.createElement(&#34;canvas&#34;);&#xA;                        tempCanvas.width = 28;&#xA;                        tempCanvas.height = 28;&#xA;                        const tctx = tempCanvas.getContext(&#34;2d&#34;);&#xA;&#xA;                        &#xA;                        tctx.fillStyle = &#34;black&#34;;&#xA;                        tctx.fillRect(0, 0, 28, 28);&#xA;&#xA;                        &#xA;                        const maxDim = Math.max(digitWidth, digitHeight);&#xA;                        const scale = 20 / maxDim;&#xA;&#xA;                        const targetWidth = digitWidth * scale;&#xA;                        const targetHeight = digitHeight * scale;&#xA;&#xA;                        &#xA;                        const dx = (28 - targetWidth) / 2;&#xA;                        const dy = (28 - targetHeight) / 2;&#xA;&#xA;                        tctx.imageSmoothingEnabled = true;&#xA;                        tctx.imageSmoothingQuality = &#34;high&#34;;&#xA;&#xA;                        &#xA;                        tctx.drawImage(&#xA;                                canvas, &#xA;                                minX, minY, digitWidth, digitHeight, &#xA;                                dx, dy, targetWidth, targetHeight    &#xA;                        );&#xA;&#xA;                        &#xA;                        const imageData = tctx.getImageData(0, 0, 28, 28);&#xA;                        const input = [];&#xA;&#xA;                        for (let i = 0; i &lt; imageData.data.length; i += 4) {&#xA;                                const r = imageData.data[i];&#xA;                                input.push(r / 255.0); &#xA;                        }&#xA;&#xA;                        return input;&#xA;                }&#xA;&#xA;                function argmax(arr) {&#xA;                        let best = 0;&#xA;                        for (let i = 1; i &lt; arr.length; i++) {&#xA;                                if (arr[i] &gt; arr[best]) {&#xA;                                        best = i;&#xA;                                }&#xA;                        }&#xA;                        return best;&#xA;                }&#xA;&#xA;                function predict() {&#xA;                        if (!model) {&#xA;                                alert(&#34;Model is still loading, please wait a moment!&#34;);&#xA;                                return;&#xA;                        }&#xA;&#xA;                        let x = getInputTensor();&#xA;&#xA;                        x = relu(linear(x, model.l1_w, model.l1_b));&#xA;                        x = relu(linear(x, model.l2_w, model.l2_b));&#xA;                        x = relu(linear(x, model.l3_w, model.l3_b));&#xA;                        x = softmax(linear(x, model.l4_w, model.l4_b));&#xA;&#xA;                        const digit = argmax(x);&#xA;                        const confidence = (x[digit] * 100).toFixed(1);&#xA;&#xA;                        console.log(`Predicted Digit: ${digit} with ${confidence}% confidence.`);&#xA;                        document.getElementById(&#34;prediction&#34;).innerText = `Prediction: ${digit} (${confidence}%)`;&#xA;                }&#xA;        &lt;/script&gt;&#xA;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;&#xA;&lt;p&gt;Code can be found &lt;a href=&#34;https://github.com/MungShu71/autograd/tree/main/mnist&#34;&gt;here&lt;/a&gt;.&lt;/p&gt;</description>
    </item>
